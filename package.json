{
  "name": "eeg-learning-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:old": "vitest run tests/engine.test.js",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "check:translations": "node scripts/check-translations.mjs",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"tests/**/*.js\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "i18next": "^23.14.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.1",
    "react-router-dom": "7.18.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.4",
    "acorn": "^8.19.0",
    "acorn-jsx": "^5.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.23",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.10",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
